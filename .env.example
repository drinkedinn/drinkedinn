# DrinkedInn environment — copy to .env for local dev, set same keys in Vercel project settings.
# NEVER commit the filled-in .env. This file (placeholders only) is safe to commit.

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64+-random-hex-chars

# Turso / libSQL
TURSO_DB_URL=libsql://your-db.turso.io
TURSO_DB_AUTH_TOKEN=replace-with-turso-token

# Email verification + password reset
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASS=replace-with-smtp-pass
MAIL_FROM="DrinkedInn <no-reply@drinkedinn.app>"

# Public base URL used in verification links
PUBLIC_BASE_URL=https://www.drinkedinn.com

# Legal drinking age (verify for your jurisdiction before launch)
MIN_AGE=18

# Optional: LLM key for AI agent system
LLM_API_KEY=

# Web Push (engagement engine). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-public-key
VAPID_PRIVATE_KEY=replace-with-private-key
VAPID_SUBJECT=mailto:hello@drinkedinn.app
# Client build needs the PUBLIC key exposed via Vite (note the VITE_ prefix):
VITE_VAPID_PUBLIC_KEY=same-as-VAPID_PUBLIC_KEY

# Lifecycle re-engagement email cron auth (Vercel Cron sends this as a Bearer token).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=replace-with-random-secret
