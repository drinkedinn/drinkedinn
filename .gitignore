# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/

# Database (don't commit real user data)
server/*.db
server/*.db-shm
server/*.db-wal

# Environment secrets
.env
.env.local
server/.env

# Uploads (user-generated files)
server/uploads/

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Lock files (keep package-lock for reproducibility)
# package-lock.json
.vercel
.env*.local

# Project context files (may contain credentials — never commit)
CLAUDE.md
*-hardening.md

# Secrets
.env.local
.env.*.local

# DB dumps
dump.sql
*.sqlite
*.sqlite3
*.db

# Cloudflare local dev secrets
.dev.vars
.wrangler/

# Every .env variant, not just the few listed above.
# `vercel env pull` writes .env.production by default, which none of the
# earlier patterns matched — so a routine pull left real production
# credentials in a committable file.
.env.*
!.env.example
*.env
.dev.vars
.dev.vars.*
.env*
