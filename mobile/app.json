{
  "expo": {
    "name": "DrinkedInn",
    "slug": "drinkedinn",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "drinkedinn",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF8F2",
    "icon": "./assets/icon.png",
    "primaryColor": "#C8831F",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drinkedinn.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DrinkedInn needs access to your photos so you can share pictures of your pours.",
        "NSCameraUsageDescription": "DrinkedInn uses your camera so you can photograph the drink you're sharing.",
        "NSFaceIDUsageDescription": "DrinkedInn uses Face ID to unlock the app when app lock is turned on.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.drinkedinn.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8831F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8F2",
          "dark": {
            "backgroundColor": "#0D0F16"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DrinkedInn needs access to your photos so you can share pictures of your pours.",
          "cameraPermission": "DrinkedInn uses your camera so you can photograph the drink you're sharing."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DrinkedInn uses Face ID to unlock the app when app lock is turned on."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-image",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
